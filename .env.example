# All variables are optional. The site builds and runs without any of them.

# Canonical URL used for metadata, Open Graph images, sitemap.xml and robots.txt.
# On Vercel this falls back to the project's production URL automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form endpoint (e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx).
# When unset, the form opens the visitor's email app with the message pre-filled instead.
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
